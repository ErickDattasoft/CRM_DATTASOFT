---
// Página pública de registro a eventos — DATTASOFT CRM
// URL: /registro-evento?id=ev_XXXXX
const firebaseApiKey = import.meta.env.PUBLIC_FIREBASE_API_KEY || "AIzaSyDT6EkBk0pMA9t_APJlLPku_EWco_OMM3Q";
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registro de Evento</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Outfit', sans-serif;
      background: #0a0c14;
      color: #e2e8f0;
      min-height: 100vh;
    }

    /* Hero superior */
    .hero {
      background: linear-gradient(135deg, #1a1e2e 0%, #0f1117 50%, #1a1228 100%);
      border-bottom: 1px solid rgba(99,102,241,0.2);
      padding: 48px 24px 56px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: "";
      position: absolute;
      top: -60px; left: 50%; transform: translateX(-50%);
      width: 400px; height: 400px;
      background: radial-gradient(circle, rgba(99,102,241,0.12) 0%, transparent 70%);
      pointer-events: none;
    }
    .empresa-logo-wrap {
      margin-bottom: 20px;
      display: flex;
      justify-content: center;
    }
    .empresa-logo-wrap img {
      width: 80px; height: 80px;
      border-radius: 18px;
      object-fit: contain;
      box-shadow: 0 8px 32px rgba(99,102,241,0.3);
      border: 2px solid rgba(99,102,241,0.3);
    }
    .empresa-logo-fallback {
      width: 80px; height: 80px;
      background: linear-gradient(135deg, #6366f1, #8b5cf6);
      border-radius: 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      margin-bottom: 0;
      box-shadow: 0 8px 32px rgba(99,102,241,0.3);
    }
    .empresa-nombre-txt {
      font-size: 0.85rem;
      font-weight: 600;
      color: #6366f1;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-top: 12px;
      margin-bottom: 28px;
    }
    .evento-titulo-hero {
      font-size: clamp(1.6rem, 5vw, 2.4rem);
      font-weight: 900;
      color: #f1f5f9;
      line-height: 1.2;
      margin-bottom: 12px;
    }
    .evento-meta-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: center;
      margin-top: 16px;
    }
    .chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 24px;
      padding: 6px 16px;
      font-size: 0.85rem;
      color: #cbd5e1;
      font-weight: 500;
    }
    .chip-icon { font-size: 1rem; }

    /* Descripción del evento */
    .evento-desc {
      max-width: 640px;
      margin: 0 auto;
      padding: 32px 24px 0;
      text-align: center;
    }
    .evento-desc p {
      font-size: 1rem;
      color: #94a3b8;
      line-height: 1.7;
    }

    /* Formulario */
    .form-wrapper {
      max-width: 560px;
      margin: 0 auto;
      padding: 32px 24px 60px;
    }
    .form-card {
      background: #141827;
      border: 1px solid rgba(99,102,241,0.2);
      border-radius: 20px;
      padding: 36px 32px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    }
    .form-card-title {
      font-size: 1.7rem;
      font-weight: 800;
      color: #f1f5f9;
      margin-bottom: 8px;
      letter-spacing: -0.01em;
    }
    .form-card-subtitle {
      font-size: 0.85rem;
      color: #64748b;
      margin-bottom: 30px;
    }
    .form-group {
      margin-bottom: 22px;
    }
    label {
      display: block;
      font-size: 0.75rem;
      font-weight: 700;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 9px;
    }
    .required { color: #6366f1; }
    input, select, textarea {
      display: block;
      width: 100%;
      background: rgba(255,255,255,0.04);
      border: 1.5px solid rgba(255,255,255,0.09);
      border-radius: 10px;
      padding: 13px 15px;
      color: #e2e8f0;
      font-size: 0.95rem;
      font-family: inherit;
      transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
      outline: none;
    }
    input::placeholder, textarea::placeholder { color: #475569; }
    input:focus, select:focus, textarea:focus {
      border-color: #6366f1;
      background: rgba(99,102,241,0.06);
      box-shadow: 0 0 0 3px rgba(99,102,241,0.12);
    }
    select option { background: #141827; }
    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    @media(max-width: 500px) { .form-row { grid-template-columns: 1fr; } .form-card { padding: 24px 20px; } }

    .form-section-label {
      display: inline-block;
      font-size: 0.85rem;
      font-weight: 800;
      color: #c7d2fe;
      background: rgba(99,102,241,0.18);
      border: 1px solid rgba(99,102,241,0.35);
      border-radius: 999px;
      padding: 5px 14px;
      margin: 30px 0 16px;
    }
    .form-section-label:first-of-type { margin-top: 0; }
    .form-hint {
      font-size: 0.72rem;
      color: #64748b;
      margin: -10px 0 18px;
    }
    .form-highlight-box {
      background: rgba(99,102,241,0.08);
      border: 1px solid rgba(99,102,241,0.25);
      border-radius: 12px;
      padding: 16px 18px;
      margin-bottom: 18px;
    }
    .form-highlight-box .form-group { margin-bottom: 0; }

    .btn-submit {
      width: 100%;
      padding: 16px;
      background: linear-gradient(135deg, #6366f1, #8b5cf6);
      color: white;
      border: none;
      border-radius: 12px;
      font-size: 1.05rem;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      transition: opacity 0.2s, transform 0.1s, box-shadow 0.2s;
      margin-top: 10px;
      box-shadow: 0 4px 20px rgba(99,102,241,0.4);
      letter-spacing: 0.01em;
    }
    .btn-submit:hover { opacity: 0.9; box-shadow: 0 6px 28px rgba(99,102,241,0.5); }
    .btn-submit:active { transform: scale(0.98); }
    .btn-submit:disabled { background: #1e2535; color: #475569; box-shadow: none; cursor: not-allowed; }

    /* Estados: éxito / error */
    .state-box {
      text-align: center;
      padding: 48px 24px;
    }
    .state-icon { font-size: 4rem; margin-bottom: 16px; display: block; }
    .state-title { font-size: 1.5rem; font-weight: 800; margin-bottom: 10px; }
    .state-subtitle { font-size: 0.9rem; color: #64748b; line-height: 1.6; }
    .state-success .state-title { color: #34d399; }
    .state-error .state-title { color: #f87171; }

    /* Loading inicial */
    #loading-screen {
      position: fixed; inset: 0;
      background: #0a0c14;
      display: flex; align-items: center; justify-content: center;
      z-index: 100; flex-direction: column; gap: 16px;
    }
    .spinner {
      width: 44px; height: 44px;
      border: 3px solid rgba(99,102,241,0.2);
      border-top-color: #6366f1;
      border-radius: 50%;
      animation: spin 0.75s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    #app { display: none; }
  </style>
</head>
<body>

  <div id="loading-screen">
    <div class="spinner"></div>
    <div style="color:#475569;font-size:0.85rem;font-weight:500;">Cargando evento...</div>
  </div>

  <div id="app">

    <!-- HERO -->
    <div class="hero" id="hero-section">
      <div class="empresa-logo-wrap">
        <img id="empresa-logo" alt="Logo" style="display:none;">
        <div class="empresa-logo-fallback" id="logo-fallback">🏢</div>
      </div>
      <div class="empresa-nombre-txt" id="empresa-nombre">DATTASOFT</div>
      <div class="evento-titulo-hero" id="evento-titulo">Cargando...</div>
      <div class="evento-meta-chips" id="evento-chips"></div>
    </div>

    <!-- DESCRIPCIÓN -->
    <div class="evento-desc" id="evento-desc-wrap" style="display:none;">
      <p id="evento-desc"></p>
    </div>

    <!-- FORMULARIO -->
    <div class="form-wrapper">
      <div class="form-card" id="form-card">
        <!-- Contenido inyectado por JS -->
      </div>
    </div>

  </div>

  <script type="module" is:inline define:vars={{ firebaseApiKey, turnstileSitekey: "0x4AAAAAAEcGD5ERafq0Rq8B" }}>
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
    import { getFirestore, doc, getDoc } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";

    const firebaseConfig = {
      apiKey: firebaseApiKey,
      authDomain: "agenda-crm-netlify.firebaseapp.com",
      projectId: "agenda-crm-netlify",
    };

    const app = initializeApp(firebaseConfig);
    // Solo lectura del documento público reducido (agenda/publico, allow read: if true) — no
    // hace falta sesión. Guardar la inscripción ya no pasa por aquí, ver más abajo: se manda a
    // /registrar-evento, que valida el captcha y escribe en Firestore desde el servidor.
    const db  = getFirestore(app);
    const params  = new URLSearchParams(location.search);
    const eventoId = params.get("id");
    let turnstileWidgetId = null; // asignado al renderizar el widget (ver más abajo)

    // Página pública sin login — cualquier visitante puede escribir cualquier cosa en el
    // formulario. Sin esto, un nombre/empresa tipo <img src=x onerror=...> se insertaba tal
    // cual en el correo de confirmación y en el correo de aviso al admin.
    function escapeHtml(s) {
      return (s === null || s === undefined) ? "" : String(s)
        .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;").replace(/'/g, "&#39;");
    }
    const isValidEmail = (e) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e);

    // No prueba que el número exista (eso solo lo sabe WhatsApp), pero filtra basura obvia:
    // muy corto/largo, o patrones tipo 1111111111 / 1234567890 que nadie escribe por accidente.
    function isValidTelefono(t) {
      const digitos = t.replace(/[^\d]/g, "");
      if (digitos.length < 10 || digitos.length > 13) return false;
      if (/^(\d)\1+$/.test(digitos)) return false;
      const secuencias = ["0123456789", "1234567890", "9876543210"];
      if (secuencias.some(s => digitos.includes(s.slice(0, 10)))) return false;
      return true;
    }


    async function main() {
      try { await signInAnonymously(auth); } catch(e) { console.warn("Auth:", e); }

      const loadingScreen = document.getElementById("loading-screen");
      const appDiv = document.getElementById("app");
      const formCard = document.getElementById("form-card");

      // Cargar datos públicos (logo, nombre, eventos) desde un documento aparte y reducido
      // (agenda/publico) en vez de agenda/datos completo — ese documento grande trae también
      // clientes y tickets con notas internas, que esta página nunca debería poder leer solo
      // para mostrar un logo. El correo de soporte para el aviso de "evento no es para ti" ahora
      // lo resuelve /registrar-evento del lado del servidor, no se necesita aquí.
      let nombreEmpresaCRM = "DATTASOFT";
      let eventosPublicos = [];
      try {
        const snap = await getDoc(doc(db, "agenda", "publico"));
        if (snap.exists()) {
          const d = snap.data();
          if (d.logoEmpresa) {
            const img = document.getElementById("empresa-logo");
            img.src = d.logoEmpresa;
            img.style.display = "block";
            document.getElementById("logo-fallback").style.display = "none";
          }
          if (d.nombreEmpresa) {
            nombreEmpresaCRM = d.nombreEmpresa;
            document.getElementById("empresa-nombre").textContent = nombreEmpresaCRM;
            document.title = `Registro — ${nombreEmpresaCRM}`;
          }
          eventosPublicos = d.eventos || [];
        }
      } catch(e) {}

      loadingScreen.style.display = "none";
      appDiv.style.display = "block";

      if (!eventoId) {
        showNotFound("Link inválido", "No se especificó el evento. Verifica el link que te compartieron.");
        return;
      }

      // Buscar evento (ya viene en el mismo documento público cargado arriba)
      const evento = eventosPublicos.find(e => e.id === eventoId) || null;

      if (!evento) {
        showNotFound("Evento no encontrado", "El evento que buscas ya no está disponible o el link es incorrecto.");
        return;
      }

      // Llenar hero
      document.getElementById("evento-titulo").textContent = evento.nombre || "Evento";

      const chips = [];
      if (evento.fecha) {
        const fd = new Date(evento.fecha + "T12:00:00").toLocaleDateString("es-MX", { weekday:"long", day:"numeric", month:"long", year:"numeric" });
        chips.push(`<span class="chip"><span class="chip-icon">📅</span>${fd}</span>`);
      }
      if (evento.hora) chips.push(`<span class="chip"><span class="chip-icon">🕐</span>${evento.hora}</span>`);
      if (evento.sistema) chips.push(`<span class="chip"><span class="chip-icon">💼</span>${evento.sistema}</span>`);
      document.getElementById("evento-chips").innerHTML = chips.join("");

      if (evento.notas) {
        document.getElementById("evento-desc").textContent = evento.notas;
        document.getElementById("evento-desc-wrap").style.display = "block";
      }

      // Formulario
      formCard.innerHTML = `
        <div class="form-card-title">📝 Completa tu registro</div>
        <div class="form-card-subtitle">Llena el formulario y te esperamos en el evento.</div>
        <form id="form-registro">
          <div class="form-section-label">Tus datos</div>
          <div class="form-row">
            <div class="form-group">
              <label>Nombre completo <span class="required">*</span></label>
              <input id="r-nombre" type="text" placeholder="Tu nombre y apellido" required autocomplete="name">
            </div>
            <div class="form-group">
              <label>Empresa / Organización</label>
              <input id="r-empresa" type="text" placeholder="Nombre de tu empresa" autocomplete="organization">
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>Correo electrónico</label>
              <input id="r-correo" type="email" placeholder="tu@correo.com" autocomplete="email">
            </div>
            <div class="form-group">
              <label>Teléfono</label>
              <input id="r-telefono" type="tel" placeholder="55 1234 5678" autocomplete="tel">
            </div>
          </div>
          <div class="form-hint">Ingresa al menos uno de los dos (correo o teléfono) <span class="required">*</span></div>

          ${evento.sistema ? `
          <div class="form-highlight-box">
            <div class="form-group">
              <label>¿Actualmente utilizas ${escapeHtml(evento.sistema)}? <span class="required">*</span></label>
              <select id="r-usa-sistema" required>
                <option value="">— Selecciona —</option>
                <option value="Sí">Sí, lo utilizo</option>
                <option value="No">No lo utilizo</option>
              </select>
            </div>
          </div>` : ""}

          <div class="form-section-label">Preferencias</div>
          <div class="form-group">
            <label>¿Cómo te enteraste del evento?</label>
            <select id="r-fuente">
              <option value="">— Selecciona una opción —</option>
              <option>📘 Facebook</option>
              <option>📸 Instagram</option>
              <option>💼 LinkedIn</option>
              <option>💬 WhatsApp</option>
              <option>👥 Recomendación de un amigo</option>
              <option>✉️ Correo electrónico</option>
              <option>🌐 Página web</option>
              <option>Otro</option>
            </select>
          </div>
          <div class="form-group" style="display:flex; align-items:flex-start; gap:10px; margin-bottom:0;">
            <input type="checkbox" id="r-canal-wsp" style="width:auto; margin-top:3px; accent-color:#6366f1;">
            <label for="r-canal-wsp" style="text-transform:none; font-weight:500; color:#94a3b8; font-size:0.85rem; margin-bottom:0;">Quiero unirme al canal de WhatsApp para recibir avisos y novedades.</label>
          </div>

          <div id="turnstile-widget" style="margin:22px 0 6px;"></div>
          <button type="submit" class="btn-submit" id="btn-submit">✅ Confirmar mi Registro</button>
        </form>
      `;

      // El div de arriba se insertó DESPUÉS de que el script de Turnstile ya corrió su detección
      // automática de .cf-turnstile en la página (se ejecuta una sola vez, al cargar) — por eso
      // se renderiza a mano en vez de usar el atributo declarativo class="cf-turnstile".
      await new Promise(resolve => {
        let intentos = 0;
        const esperar = setInterval(() => {
          intentos++;
          if (window.turnstile) {
            clearInterval(esperar);
            turnstileWidgetId = window.turnstile.render("#turnstile-widget", { sitekey: turnstileSitekey, action: "registro_evento" });
            resolve(null);
          } else if (intentos > 50) { // ~5s de margen — el script pudo tardar/fallar en cargar
            clearInterval(esperar);
            resolve(null);
          }
        }, 100);
      });

      document.getElementById("form-registro").addEventListener("submit", async (e) => {
        e.preventDefault();
        const nombre = document.getElementById("r-nombre").value.trim();
        // minúsculas para que "Foo@x.com" y "foo@X.com" no generen dos inscripciones distintas
        const correo = document.getElementById("r-correo").value.trim().toLowerCase();
        const telefono = document.getElementById("r-telefono").value.trim();

        if (!nombre) { alert("Ingresa tu nombre completo."); return; }
        if (!correo && !telefono) { alert("Ingresa al menos un correo electrónico o un teléfono de contacto."); return; }
        if (correo && !isValidEmail(correo)) { alert("Ingresa un correo electrónico válido."); return; }
        if (telefono && !isValidTelefono(telefono)) { alert("Ingresa un teléfono válido (10 dígitos)."); return; }

        const usaSistema = evento.sistema ? document.getElementById("r-usa-sistema")?.value : "";
        if (evento.sistema && !usaSistema) { alert(`Indica si utilizas ${evento.sistema}.`); return; }

        const turnstileToken = window.turnstile?.getResponse(turnstileWidgetId) || "";
        if (!turnstileToken) { alert("Espera un momento a que termine la verificación anti-bots y vuelve a intentar."); return; }

        const empresaReg = document.getElementById("r-empresa").value.trim();
        const fuente      = document.getElementById("r-fuente").value.replace(/^[^\w]+/, "").trim();
        const canalWsp    = document.getElementById("r-canal-wsp")?.checked || false;

        const btn = document.getElementById("btn-submit");
        btn.disabled = true;
        btn.textContent = "⏳ Registrando...";

        // El guardado real (validar captcha, checar duplicados, escribir en Firestore, mandar
        // correos) vive en /registrar-evento — este formulario ya no toca Firestore directo.
        try {
          const resp = await fetch("/registrar-evento", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              eventoId, nombre, empresa: empresaReg, correo, telefono, fuente,
              usaSistema, deseaCanalWhatsapp: canalWsp, turnstileToken,
            }),
          });
          const data = await resp.json().catch(() => null);

          if (!resp.ok || !data || !data.ok) {
            const detalle = data?.debug ? ` (${JSON.stringify(data.debug)})` : "";
            throw new Error((data?.error || "No se pudo completar el registro") + detalle);
          }

          if (data.bloqueadoPorSistema) {
            formCard.innerHTML = `
              <div class="state-box state-error">
                <span class="state-icon">🔍</span>
                <div class="state-title">Este evento no es para ti (por ahora)</div>
                <div class="state-subtitle">Este curso está pensado para quienes ya utilizan <strong>${escapeHtml(data.sistema || evento.sistema)}</strong>.
                Si buscas información sobre otro sistema, contáctanos${data.correoAdmin ? ` en <strong>${escapeHtml(data.correoAdmin)}</strong>` : ""} y con gusto te orientamos.</div>
              </div>`;
            return;
          }

          if (data.duplicado) {
            formCard.innerHTML = `
              <div class="state-box state-success">
                <span class="state-icon">ℹ️</span>
                <div class="state-title">Ya estás registrado</div>
                <div class="state-subtitle">Ya te habías registrado para este evento con estos datos. ¡Te esperamos!</div>
              </div>`;
            return;
          }

          // Éxito
          formCard.innerHTML = `
            <div class="state-box state-success">
              <span class="state-icon">🎉</span>
              <div class="state-title">¡Registro exitoso!</div>
              <div class="state-subtitle">
                ¡Hola <strong>${nombre}</strong>! Quedaste registrado para<br>
                <strong>${evento.nombre}</strong>.<br><br>
                Te esperamos el ${evento.fecha ? new Date(evento.fecha + "T12:00:00").toLocaleDateString("es-MX",{weekday:"long",day:"numeric",month:"long"}) : ""}${evento.hora ? " a las " + evento.hora : ""}. 😊
              </div>
            </div>`;
        } catch(err) {
          btn.disabled = false;
          btn.textContent = "✅ Confirmar mi Registro";
          window.turnstile?.reset(turnstileWidgetId);
          const errDiv = document.createElement("div");
          errDiv.style.cssText = "margin-top:12px;padding:12px;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:10px;color:#f87171;font-size:0.85rem;text-align:center;";
          errDiv.textContent = `❌ ${err.message || "Ocurrió un error. Por favor intenta de nuevo."}`;
          document.getElementById("form-registro").appendChild(errDiv);
          setTimeout(() => errDiv.remove(), 5000);
        }
      });
    }

    function showNotFound(titulo, msg) {
      document.getElementById("hero-section").style.display = "none";
      document.getElementById("form-card").innerHTML = `
        <div class="state-box state-error">
          <span class="state-icon">🔍</span>
          <div class="state-title">${titulo}</div>
          <div class="state-subtitle">${msg}</div>
        </div>`;
    }

    main();
  </script>
</body>
</html>
